0:{"buildId":"4CxxdLGxc51W9TYQhnRFM","data":[{"rsc":["$","$1","c",{"children":[["$","main",null,{"className":"legal-page","children":[["$","section",null,{"className":"page-hero","children":[["$","div",null,{"className":"container","children":[["$","p",null,{"className":"hero-eyebrow","children":"Legal"}],["$","h1",null,{"children":"Booking Terms"}],["$","p",null,{"children":"The terms that apply when you book a trip with us. Please read these alongside your itinerary and quote."}]]}],["$","div",null,{"className":"mural-divider mural-divider--frieze","aria-hidden":"true","children":["$","div",null,{"className":"mural-divider-inner"}]}]]}],["$","div",null,{"className":"container legal-page-body","children":[["$","p",null,{"className":"legal-updated","children":"Last updated: 28 August 2026"}],["$","h2",null,{"children":"1. Enquiries & quotes"}],["$","p",null,{"children":"Submitting a booking or enquiry form is the start of a conversation, not a confirmed booking. We'll follow up with a proposed itinerary and price, which remains valid for a limited time and is subject to availability at the point of confirmation."}],["$","h2",null,{"children":"2. Confirming a booking"}],["$","p",null,{"children":"A booking is confirmed once we've received your written agreement to the itinerary and a deposit. Unless otherwise agreed in writing, a deposit of 25% of the total trip cost is required to confirm, with the balance due no later than 30 days before your travel start date. For bookings made within 30 days of travel, full payment is required at the time of confirmation."}],["$","h2",null,{"children":"3. Changes by you"}],["$","p",null,{"children":"We'll do our best to accommodate changes to a confirmed itinerary, but changes are subject to availability and may involve a revised price. Some suppliers (hotels, internal flights) may apply their own change fees, which we'll pass on at cost."}],["$","h2",null,{"children":"4. Cancellations & refunds"}],["$","p",null,{"children":"Cancellations must be made in writing. Unless a specific supplier's policy states otherwise, the following applies to the trip cost:"}],["$","ul",null,{"children":[["$","li",null,{"children":"More than 45 days before travel: deposit is non-refundable, no further charge"}],["$","li",null,{"children":"30–45 days before travel: 50% of the total trip cost"}],["$","li",null,{"children":"Less than 30 days before travel, or no-show: 100% of the total trip cost"}]]}],["$","p",null,{"children":"Some bookings (e.g. peak-season hotels, internal flights, or special event tickets) may carry stricter, non-refundable terms set by the supplier — we'll flag these clearly in your itinerary before you confirm."}],["$","h2",null,{"children":"5. Changes by us"}],["$","p",null,{"children":"Occasionally a supplier may change or become unavailable after booking. Where this happens, we'll offer a comparable alternative at no extra cost where possible, or discuss options with you directly."}],["$","h2",null,{"children":"6. Travel documents & entry requirements"}],["$","p",null,{"children":"It's your responsibility to hold a valid passport and any visa or travel authorisation required to enter Sri Lanka (most nationalities need an ETA, applied for before departure), and to meet any other entry requirements in place at the time of travel. We're happy to point you toward the relevant official process, but we can't guarantee entry and aren't responsible for a refused visa or entry denial."}],["$","h2",null,{"children":"7. Travel insurance"}],["$","p",null,{"children":"We strongly recommend taking out travel insurance that covers trip cancellation, medical emergencies, and personal belongings, effective from the date you book."}],["$","h2",null,{"children":"8. Our role & liability"}],"$L2","$L3","$L4","$L5","$L6","$L7","$L8","$L9","$La"]}]]}],null,"$Lb"]}],"isPartial":"$@c","staleTime":"$d","varyParams":null},{"rsc":"$Le","isPartial":"$@f","staleTime":"$d","varyParams":null},{"rsc":"$L10","isPartial"