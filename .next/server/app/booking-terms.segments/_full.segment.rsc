17:["$","p",null,{"children":"Neither party is liable for a failure to perform caused by events beyond reasonable control, including natural disasters, extreme weather, civil unrest, government action, or public health emergencies. Where this affects your trip, we'll work with you in good faith on rescheduling or an appropriate resolution."}]
