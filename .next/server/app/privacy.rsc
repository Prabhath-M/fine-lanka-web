f:["$","$1","c",{"children":[["$","main",null,{"className":"legal-page","children":[["$","section",null,{"className":"page-hero","children":[["$","div",null,{"className":"container","children":[["$","p",null,{"className":"hero-eyebrow","children":"Legal"}],["$","h1",null,{"children":"Privacy Notice"}],["$","p",null,{"children":"How we collect, use, and protect the personal information you share with us."}]]}],["$","div",null,{"className":"mural-divider mural-divider--frieze","aria-hidden":"true","children":["$","div",null,{"className":"mural-divider-inner"}]}]]}],["$","div",null,{"className":"container legal-page-body","children":[["$","p",null,{"className":"legal-updated","children":"Last updated: 28 August 2026"}],["$","h2",null,{"children":"Who we are"}],["$","p",null,{"children":["This notice applies to ","Fine Lanka Tours"," (“we”, “us”, “our”), a Sri Lanka-based travel design studio at ","No. 38/18, Muthulanda, Dagonna Road, Boragodawaththa, Minuwangoda, Sri Lanka",". It explains what personal data we collect when you use this website or get in touch with us, and what we do with it."]}],["$","h2",null,{"children":"What we collect"}],["$","p",null,{"children":"We collect personal data you give us directly, through the booking form, the enquiry form, the contact page, or the newsletter sign-up. Depending on which of these you use, this may include:"}],["$","ul",null,{"children":[["$","li",null,{"children":"Your name, email address, and phone number"}],["$","li",null,{"children":"Travel dates, destinations, group size, and trip preferences"}],["$","li",null,{"children":"Any other details you choose to include in a message to us"}]]}],["$","p",null,{"children":"We do not collect payment card details through this website. If you go on to book a trip, any payment is handled directly between you and the relevant payment provider or bank, not stored by us."}],["$","h2",null,{"children":"How we use it"}],["$","p",null,{"children":"We use your information to:"}],["$","ul",null,{"children":[["$","li",null,{"children":"Respond to your enquiry and put together a travel itinerary"}],["$","li",null,{"children":"Communicate with you about a booking, before and during your trip"}],["$","li",null,{"children":"Keep records we're required to keep for accounting and legal purposes"}],["$","li",null,{"children":"Occasionally send travel updates or offers, only if you've opted in to the newsletter — you can unsubscribe at any time"}]]}],["$","p",null,{"children":"We do not sell your personal data to anyone."}],["$","h2",null,{"children":"Who we share it with"}],["$","p",null,{"children":"To arrange your trip, we may share relevant details (such as your name and travel dates) with the local partners involved in delivering it — hotels, driver-guides, and activity operators. We only share what's needed for them to do their part. We may also share data with service providers who help us run this website or process enquiries (such as email or hosting providers), under terms that require them to keep it secure and not use it for their own purposes."}],["$","h2",null,{"children":"How long we keep it"}],["$","p",null,{"children":"We keep enquiry and booking records for as long as needed to deliver your trip, respond to any follow-up questions, and meet our accounting and legal record-keeping obligations, after which it's deleted or anonymised."}],["$","h2",null,{"children":"Your rights"}],["$","p",null,{"children":"You can ask us at any time to:"}],["$","ul",null,{"children":[["$","li",null,{"children":"Tell you what personal data we hold about you"}],["$","li",null,{"children":"Correct anything that's inaccurate"}],["$","li",null,{"children":"Delete your data, where we're not required to keep it for legal reasons"}],["$","li",null,{"children":"Stop sending you marketing emails"}]]}],["$","p",null,{"children":"To do any of this, contact us using the details below."}],"$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20"]}]]}],null,"$L2